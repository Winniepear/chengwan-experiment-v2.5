{
  "name": "chengwan-h5-netlify-fullstack",
  "version": "2.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "build:manifest": "node scripts/build-manifest.mjs",
    "validate": "node scripts/validate.mjs",
    "dev": "netlify dev",
    "sync:config": "node scripts/sync-config.mjs",
    "build": "npm run sync:config && npm run validate && npm run build:manifest",
    "test": "node --test tests/*.test.mjs",
    "test:preview": "node tests/preview-server.mjs"
  },
  "dependencies": {
    "@netlify/database": "latest",
    "@netlify/functions": "latest"
  },
  "devDependencies": {
    "netlify-cli": "26.2.0"
  }
}
